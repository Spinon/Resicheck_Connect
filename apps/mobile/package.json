{
  "name": "resicheck-connect-demo",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "prebuild:android": "node scripts/expo.mjs prebuild --platform android --no-install",
    "export:android": "node scripts/expo.mjs export --platform android --output-dir ../../output/mobile-bundle",
    "export:web-preview": "node scripts/expo.mjs export --platform web --output-dir ../../output/mobile-web-preview"
  },
  "dependencies": {
    "expo": "57.0.32",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
