{
  "name": "atendimento-mobile-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace do ResiCheck Connect; aplicativo em apps/mobile.",
  "scripts": {
    "project:check": "node scripts/project.mjs --check",
    "project:status": "node scripts/project.mjs --write",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:test": "npm --prefix apps/mobile test",
    "mobile:export:android": "npm --prefix apps/mobile run export:android",
    "mobile:build:android:phone": "pwsh -NoProfile -File apps/mobile/scripts/build-connected-basic-text-android.ps1 -Phone",
    "mobile:build:android:qa": "pwsh -NoProfile -File apps/mobile/scripts/build-connected-basic-text-android.ps1",
    "access:typecheck": "npm --prefix packages/access run typecheck",
    "session:typecheck": "npm --prefix packages/session run typecheck",
    "session:test": "npm --prefix packages/session test",
    "text:typecheck": "npm --prefix packages/text run typecheck",
    "text:test": "npm --prefix packages/text test",
    "access:test": "npm --prefix packages/access test",
    "chat:typecheck": "npm --prefix packages/chat run typecheck",
    "chat:test": "npm --prefix packages/chat test",
    "db:test:postgres": "pwsh -NoProfile -File scripts/test-postgres-local.ps1",
    "db:verify-candidate": "node scripts/verify-deployment-candidate.mjs",
    "chat-client:test": "npm --prefix packages/chat-client test",
    "chat-client:typecheck": "npm --prefix packages/chat-client run typecheck",
    "mobile:prepare:33": "pwsh -NoProfile -File apps/mobile/scripts/build-messaging33-android.ps1 -PrepareOnly",
    "mobile:build:33:unsigned": "pwsh -NoProfile -File apps/mobile/scripts/build-messaging33-android.ps1 -BuildUnsigned",
    "mobile:inspect:33": "pwsh -NoProfile -File apps/mobile/scripts/inspect-messaging33-apk.ps1",
    "mobile:prepare:34": "pwsh -NoProfile -File apps/mobile/scripts/build-messaging34-android.ps1 -PrepareOnly",
    "mobile:build:34:unsigned": "pwsh -NoProfile -File apps/mobile/scripts/build-messaging34-android.ps1 -BuildUnsigned",
    "mobile:inspect:34": "pwsh -NoProfile -File apps/mobile/scripts/inspect-messaging34-apk.ps1",
    "mobile:prepare:35": "pwsh -NoProfile -File apps/mobile/scripts/build-messaging35-android.ps1 -PrepareOnly",
    "mobile:build:35:unsigned": "pwsh -NoProfile -File apps/mobile/scripts/build-messaging35-android.ps1 -BuildUnsigned",
    "mobile:inspect:35": "pwsh -NoProfile -File apps/mobile/scripts/inspect-messaging35-apk.ps1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
